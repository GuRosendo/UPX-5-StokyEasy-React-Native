{
  "expo": {
    "name": "StokyEasy",
    "slug": "stokyeasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/logoStokyEasyBigger.png",
    "splash": {
      "image": "./assets/images/logoStokyEasySmaller.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/logoStokyEasyBigger.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos de acesso à câmera para tirar fotos.",
        "NSPhotoLibraryUsageDescription": "Precisamos de acesso à galeria para selecionar fotos.",
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização durante o uso."
      }
    },
    "android": {
      "package": "com.stokyeasy.app",
      "icon": "./assets/images/logoStokyEasyBigger.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoStokyEasyBigger.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "https"
          },
          "category": [
            "BROWSABLE"
          ]
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "stokyeasy"
          },
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "fe98984b-3f94-471e-a224-1b75e81d359e"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos de acesso à galeria para selecionar fotos.",
          "cameraPermission": "Precisamos de acesso à câmera para tirar fotos."
        }
      ]
    ]
  }
}
